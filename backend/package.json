{
  "name": "securebuild-backend",
  "version": "1.0.0",
  "private": true,
  "description": "SecureBuild API – CI-style supply-chain risk scanner",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
