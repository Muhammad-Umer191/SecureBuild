{
  "name": "securebuild-backend",
  "version": "1.0.0",
  "private": true,
  "description": "SecureBuild API - CI-style supply-chain risk scanner",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --forceExit --detectOpenHandles",
    "test:watch": "jest --watch --forceExit --detectOpenHandles",
    "test:endpoints": "jest tests/endpoints --forceExit --detectOpenHandles --verbose",
    "test:e2e": "jest tests/endpoints/allEndpointsTest.js --forceExit --detectOpenHandles --verbose",
    "test:services": "jest tests/services",
    "test:network": "NETWORK_TESTS=1 jest tests/services",
    "try:clone": "node scripts/try-clone.js",
    "try:discover": "node scripts/try-discover.js",
    "try:parse": "node scripts/try-parse.js",
    "scan": "node scripts/scan-cli.js",
    "lint": "eslint src/",
    "db:init": "node src/scripts/initDb.js",
    "seed": "node src/scripts/seed.js",
    "demo": "node src/scripts/seed.js && npm start"
  },
  "dependencies": {
    "@renovatebot/pep440": "^4.2.4",
    "ae-cvss-calculator": "^1.0.13",
    "bcryptjs": "^2.4.3",
    "bull": "^4.12.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.7.1",
    "morgan": "^1.10.0",
    "semver": "^7.8.6",
    "smol-toml": "^1.9.1",
    "winston": "^3.14.2"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.0.1",
    "nodemon": "^3.1.7",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
